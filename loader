local function getKeyStartTime(keyStr)
    if not keyStr then return os.time() end
    local id = tostring(keyStr) .. "|" .. tostring(deviceId)
    local t = keyStarts[id]
    if type(t) ~= "number" then
        t = os.time()
        keyStarts[id] = t
        saveKeyStarts(keyStarts)
    end
    return t
end

local function keySecondsLeft(entry)
    if not entry then return 0 end
    if entry.hours == 0 then return math.huge end

    if entry.personal == true or entry.hours == 24 then
        local started = getKeyStartTime(entry.key)
        local elapsed = os.time() - started
        return math.max(0, 24 * 3600 - elapsed)
    end

    local elapsed = os.time() - (entry.created or 0)
    return math.max(0, entry.hours * 3600 - elapsed)
end

