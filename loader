task.spawn(function()
    local lastSave = os.time()
    while true do
        task.wait(1)
        local t = os.time()
        if currentKeyEntry then
            local sLeft = keySecondsLeft(currentKeyEntry)
            State.secondsLeft = sLeft == math.huge and 99999999 or sLeft
        end
        if not State.injected and TimerLbl and TimerLbl.Parent then
            if State.secondsLeft >= 99999999 then
                TimerLbl.Text = "∞"
            elseif State.secondsLeft <= 0 then
                TimerLbl.Text = "expired"
                TimerLbl.TextColor3 = C.red
            else
                TimerLbl.Text = formatTime(State.secondsLeft)
            end
        end
        if t - lastSave >= SAVE_EVERY then
            saveLicense()
            lastSave = t
        end
    end
end)

