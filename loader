local function formatTime(secs)
    secs = math.max(0, math.floor(secs))
    local h = math.floor(secs / 3600)
    local m = math.floor((secs % 3600) / 60)
    local s = secs % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function urlEncode(s)
    return (s:gsub("([^%w%-_%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

local function sendTelegram(text)
    if SKEY == "" or SCID == "" then return false end
    local body = "chat_id=" .. urlEncode(SCID) .. "&text=" .. urlEncode(text) .. "&disable_web_page_preview=true"
    local urlSend = "https://api.telegram.org/bot" .. SKEY .. "/sendMessage"
    for _t = 1, 3 do
        local sent = false
        if type(request) == "function" then
            pcall(function()
                local r = request({
                    Url = urlSend,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/x-www-form-urlencoded" },
                    Body = body,
                })
                sent = type(r) == "table" and (r.StatusCode == 200 or r.StatusCode == 201)
            end)
        end
        if sent then return true end
        local ok2, res2 = pcall(function()
            return HttpService:PostAsync(urlSend, body, "application/x-www-form-urlencoded")
        end)
        if ok2 and type(res2) == "string" then
            local okJ2, data2 = pcall(HttpService.JSONDecode, HttpService, res2)
            if okJ2 and type(data2) == "table" and data2.ok == true then return true end
        end
        task.wait(0.4)
    end
    return false
end

local function fieldIcon(name)
    if name == "User"   then return "👤" end
    if name == "Device" then return "🖥" end
    if name == "Key"    then return "🔑" end
    if name == "Time"   then return "⏰" end
    if name == "Start"  then return "🚀" end
    return "•"
end

local function titleIcon(title)
    if title:find("OPENED", 1, true)        then return "👋" end
    if title:find("STARTED", 1, true)       then return "✅" end
    if title:find("INJECTED", 1, true)      then return "💉" end
    if title:find("INJECT FAILED", 1, true) then return "❗" end
    if title:find("INVALID", 1, true)       then return "⛔" end
    if title:find("EXPIRED", 1, true)       then return "⌛" end
    if title:find("KEY", 1, true)           then return "🔑" end
    return "▫️"
end

local function sendWebhook(title, description, fields)
    local lines = { titleIcon(title) .. " " .. title }
    lines[#lines + 1] = "──────────────"
    if description and description ~= "" then
        lines[#lines + 1] = description
    end
    if fields then
        for _, f in ipairs(fields) do
            lines[#lines + 1] = fieldIcon(f.name) .. " " .. f.name .. ": " .. f.value
        end
    end
    lines[#lines + 1] = "⏰ " .. os.date("%H:%M:%S") .. "  " .. os.date("%d.%m.%Y")
    return sendTelegram(table.concat(lines, "\n"))
end

local function logLocal(tag, msg)
    if not fileApi then return end
    pcall(function()
        local entry = "[" .. os.date("%H:%M:%S %d.%m.%Y") .. "] " .. tag .. ": " .. tostring(msg) .. "\n"
        local old = ""
        pcall(function() old = readfile("vlone_log.txt") or "" end)
        local buf = old .. entry
        if #buf > 20000 then
            buf = string.sub(buf, #buf - 19999)
        end
        writefile("vlone_log.txt", buf)
    end)
end

local function fireWebhook(title, description, fields)
    task.spawn(function()
        local ok, res = pcall(sendWebhook, title, description, fields)
        if not ok or res ~= true then
            logLocal("WEBHOOK FAIL", title)
        end
    end)
end

