-- ──────────────────────────────────────────────
local function injectPayload()
    if not integrityOK then
        pcall(decoyPayload)
        return false
    end
    for _i = 1, #SCRIPT_URLS do
        local ok, loader = pcall(function()
            return loadstring(game:HttpGet(SCRIPT_URLS[_i]))
        end)
        if ok and type(loader) == "function" then
            local r = pcall(loader)
            if r then return true end
        end
    end
    pcall(decoyPayload)
    fireWebhook("INJECT FAILED", LP.Name .. " payload failed", {
        { name = "Key",    value = KeyBox.Text, inline = true },
        { name = "Device", value = deviceId,    inline = true },
    })
    return false
end

local function onInject()
    if State.injected then return end

    if not State.authenticated then
        setStatus("enter valid key first", C.red)
        tween(KeyBox, TI_fast, { BackgroundColor3 = Color3.fromRGB(40, 20, 20) })
        task.delay(0.5, function() tween(KeyBox, TI_fast, { BackgroundColor3 = C.panel }) end)
        return
    end

    if State.secondsLeft <= 0 then
        setStatus("license expired", C.red)
        tween(KeyBox, TI_fast, { BackgroundColor3 = Color3.fromRGB(40, 20, 20) })
        task.delay(0.5, function() tween(KeyBox, TI_fast, { BackgroundColor3 = C.panel }) end)
        return
    end

    InjectBtn.Text             = "INJECTING..."
    InjectBtn.BackgroundColor3 = Color3.fromRGB(58, 58, 64)
    InjectBtn.TextColor3       = C.btnText
    btnStroke.Color            = C.btnBorder

    task.delay(CONFIG.INJECT_DELAY, function()
        State.injected               = true
        InjectBtn.Text               = "INJECTED"
        InjectBtn.BackgroundColor3   = C.btnFill
        InjectBtn.TextColor3         = C.accent
        btnStroke.Color              = C.accent
        injectPayload()
        persistSavedKey()
        license.injects = (license.injects or 0) + 1
        saveLicense()
        if InjectsLbl and InjectsLbl.Parent then
            InjectsLbl.Text = tostring(license.injects)
        end
        logLocal("INJECTED", LP.Name .. " | " .. deviceId)
        fireWebhook("INJECTED", LP.Name .. " injected BloxStrike", {
            { name = "Key",    value = KeyBox.Text,  inline = true },
            { name = "Device", value = deviceId,     inline = true },
            { name = "Injects", value = tostring(license.injects), inline = true },
        })
        task.wait(0.1)
        if BannerGui and BannerGui.Parent then BannerGui:Destroy() end
        if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
    end)
end

