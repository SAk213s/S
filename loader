        if type(raw) == "string" and raw ~= "" then
            local data = HttpService:JSONDecode(raw)
            if type(data) == "table" and type(data.key) == "string" and data.key ~= "" then
                KeyBox.Text = data.key
                if data.save == true then setSaveKey(true) end
            end
        end
    end)
end

local function persistSavedKey()
    if not fileApi then return end
    pcall(function()
        if saveKeyEnabled then
            writefile(SAVE_KEY_FILE, HttpService:JSONEncode({
                key  = KeyBox.Text:gsub("%s", ""),
                save = true,
            }))
        else
            writefile(SAVE_KEY_FILE, HttpService:JSONEncode({ key = "", save = false }))
        end
    end)
end

