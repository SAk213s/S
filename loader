local function setStatus(text, color)
    StatusLbl.Text = text
    StatusDot.BackgroundColor3 = color
end

local function applyKey()
    local key = KeyBox.Text:gsub("%s", "")
    if key == "" then
        setStatus("waiting for key", C.red)
        State.authenticated = false
        currentKeyEntry = nil
        return
    end

    local entry = findKeyEntry(key)
    if not entry then
        setStatus("invalid key", C.red)
        State.authenticated = false
        currentKeyEntry = nil
        return
    end

    local sLeft = keySecondsLeft(entry)
    if sLeft <= 0 then
        setStatus("key expired", C.red)
        State.authenticated = false
        currentKeyEntry = nil
        return
    end

    currentKeyEntry = entry
    State.secondsLeft = sLeft == math.huge and 99999999 or sLeft
    local timeStr = entry.hours == 0 and "∞" or formatTime(sLeft)
    setStatus("key accepted  [" .. timeStr .. "]", C.accent)
    State.authenticated = true

    if not license.accepted then
        license.accepted = os.time()
        license.used = 0
        saveLicense()
    end

    if entry.personal == true or entry.hours == 24 then
        local started = getKeyStartTime(entry.key)
        logLocal("KEY START", entry.key .. " | " .. LP.Name .. " | " .. deviceId .. " | " .. os.date("%d.%m.%Y %H:%M", started))
        fireWebhook("KEY ACTIVATED", LP.Name .. " started 24h key", {
            { name = "Key",    value = entry.key,   inline = true },
            { name = "Device", value = deviceId,    inline = true },
            { name = "Start",  value = os.date("%d.%m.%Y %H:%M", started), inline = true },
        })
    end
end

KeyBox:GetPropertyChangedSignal("Text"):Connect(applyKey)
